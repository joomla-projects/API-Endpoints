X-Joomla-Token: {{api_key}}
Accept: application/vnd.api+json
Content-Type: application/json

{
  "title": "Example group",
  "context": "com_content.article",
  "description": ""
}

### Get Content Articles Field Group
# @name Get Content Articles Field Group
GET {{base_url}}/v1/fields/groups/content/articles/{{group_id}}
X-Joomla-Token: {{api_key}}
Accept: application/vnd.api+json

### Update Content Articles Field Group
# @name Update Content Articles Field Group
PATCH {{base_url}}/v1/fields/groups/content/articles/{{group_id}}
X-Joomla-Token: {{api_key}}
Accept: application/vnd.api+json
