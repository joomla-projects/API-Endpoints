# Config Component
#
# Generated from the OpenAPI spec of the Joomla Web Services API 6.2.2.
# Set base_url and api_key in http-client.env.json and http-client.private.env.json.

@component_name = com_content

### Get Component Configuration
# @name Get Component Configuration
# Optional query parameters: page[offset], page[limit]
GET {{base_url}}/v1/config/{{component_name}}
X-Joomla-Token: {{api_key}}
Accept: application/vnd.api+json

### Update Component Configuration
# @name Update Component Configuration
PATCH {{base_url}}/v1/config/{{component_name}}
X-Joomla-Token: {{api_key}}
Accept: application/vnd.api+json
Content-Type: application/json

{
  "show_title": 1
}
