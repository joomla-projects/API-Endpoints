# Contacts
#
# Generated from the OpenAPI spec of the Joomla Web Services API 6.2.0.
# Set base_url and api_key in http-client.env.json and http-client.private.env.json.

@contact_id = 1

### List Contacts
# @name List Contacts
# Optional query parameters: page[offset], page[limit]
GET {{base_url}}/v1/contacts
X-Joomla-Token: {{api_key}}
Accept: application/vnd.api+json

### Add Contact
# @name Add Contact
POST {{base_url}}/v1/contacts
X-Joomla-Token: {{api_key}}
Accept: application/vnd.api+json
Content-Type: application/json

{
  "name": "Example contact",
  "catid": 4,
  "language": "*"
}

### Get Contact
# @name Get Contact
GET {{base_url}}/v1/contacts/{{contact_id}}
X-Joomla-Token: {{api_key}}
Accept: application/vnd.api+json

### Update Contact
# @name Update Contact
PATCH {{base_url}}/v1/contacts/{{contact_id}}
X-Joomla-Token: {{api_key}}
Accept: application/vnd.api+json
Content-Type: application/json

{
  "name": "Example",
  "alias": "Example",
  "version_note": "Example"
}

### Delete Contact
# @name Delete Contact
DELETE {{base_url}}/v1/contacts/{{contact_id}}
X-Joomla-Token: {{api_key}}
Accept: application/vnd.api+json
