# Messages
#
# Generated from the OpenAPI spec of the Joomla Web Services API 6.2.1.
# Set base_url and api_key in http-client.env.json and http-client.private.env.json.

@message_id = 1

### List Messages
# @name List Messages
# Optional query parameters: page[offset], page[limit]
GET {{base_url}}/v1/messages
X-Joomla-Token: {{api_key}}
Accept: application/vnd.api+json

### Add Message
# @name Add Message
POST {{base_url}}/v1/messages
X-Joomla-Token: {{api_key}}
Accept: application/vnd.api+json
Content-Type: application/json

{
  "user_id_to": 1,
  "subject": "Example",
  "message": "Example"
}

### Get Message
# @name Get Message
GET {{base_url}}/v1/messages/{{message_id}}
X-Joomla-Token: {{api_key}}
Accept: application/vnd.api+json

### Update Message
# @name Update Message
PATCH {{base_url}}/v1/messages/{{message_id}}
X-Joomla-Token: {{api_key}}
Accept: application/vnd.api+json
Content-Type: application/json

{
  "user_id_to": 1,
  "subject": "Example",
  "message": "Example"
}

### Delete Message
# @name Delete Message
DELETE {{base_url}}/v1/messages/{{message_id}}
X-Joomla-Token: {{api_key}}
Accept: application/vnd.api+json
