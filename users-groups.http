# Users Groups
#
# Generated from the OpenAPI spec of the Joomla Web Services API 6.2.1.
# Set base_url and api_key in http-client.env.json and http-client.private.env.json.

@group_id = 1

### List User Groups
# @name List User Groups
# Optional query parameters: page[offset], page[limit]
GET {{base_url}}/v1/users/groups
X-Joomla-Token: {{api_key}}
Accept: application/vnd.api+json

### Add User Group
# @name Add User Group
POST {{base_url}}/v1/users/groups
X-Joomla-Token: {{api_key}}
Accept: application/vnd.api+json
Content-Type: application/json

{
  "title": "Example group",
  "parent_id": 1
}

### Get User Group
# @name Get User Group
GET {{base_url}}/v1/users/groups/{{group_id}}
X-Joomla-Token: {{api_key}}
Accept: application/vnd.api+json

### Update User Group
# @name Update User Group
PATCH {{base_url}}/v1/users/groups/{{group_id}}
X-Joomla-Token: {{api_key}}
Accept: application/vnd.api+json
Content-Type: application/json

{
  "title": "Example",
  "parent_id": 1,
  "actions": []
}

### Delete User Group
# @name Delete User Group
DELETE {{base_url}}/v1/users/groups/{{group_id}}
X-Joomla-Token: {{api_key}}
Accept: application/vnd.api+json
